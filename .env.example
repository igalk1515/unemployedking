# Copy to .env and fill in. Generate secrets with:
#   PowerShell: [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Max 256 }))
#   or:         openssl rand -base64 32

# SQLite for dev. For Postgres: change provider in prisma/schema.prisma to
# "postgresql" and use e.g. postgresql://user:pass@localhost:5432/unemployedking
DATABASE_URL="file:./dev.db"

AUTH_SECRET=""            # openssl rand -base64 32
AUTH_TRUST_HOST="true"

# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client (Web)
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
# Enable the Gmail API. Keep the OAuth consent screen in Testing mode and add
# yourself as a test user (100 max, refresh tokens expire every 7 days).
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# aistudio.google.com/apikey -> API keys. Used for Layer-2 email classification
# (gemini-2.5-flash-lite). Optional: without it only rule-based classification runs.
GEMINI_API_KEY=""

# AES-256-GCM key for refresh-token encryption at rest (base64, 32 bytes)
TOKEN_ENCRYPTION_KEY=""   # openssl rand -base64 32

# Shared secret for the cron endpoints (/api/cron/ghost-sweep and
# /api/cron/auto-sync). Schedule auto-sync to run at least daily so users'
# chosen cadences (every 1 / 7 / N days) actually fire.
CRON_SECRET=""

# Dev-only username login (bypasses Google). NEVER "true" in production.
DEV_LOGIN="false"

NEXT_PUBLIC_APP_URL="http://localhost:3000"

# The site owner's sign-in email. Only this account sees the "Access requests"
# card on the dashboard (pending invite-list emails to add as Google test users).
OWNER_EMAIL=""
